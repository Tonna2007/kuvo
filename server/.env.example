APP_ENV=prod
APP_STORE=postgres
HTTP_ADDR=:8080
JWT_SECRET=change-me
OTP_PEPPER=change-me
DEV_OTP=1234
STRICT_OTP=0

# Supabase Postgres (Settings → Database → URI)
DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Optional Redis (Render Redis or Upstash). Memory cache is used if empty and APP_STORE=memory.
REDIS_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kuvo-media
R2_PUBLIC_BASE=https://pub-xxxxx.r2.dev

# Termii SMS — leave empty so 1234 works. Set key, then tap Send code in the app to spend SMS.
TERMII_API_KEY=
TERMII_FROM=Kuvo

CORS_ORIGINS=*
